# ==========================
# 🧱 GRADLE / ANDROID
# ==========================
.gradle
**/build/
!**/src/**/build/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignoring Gradle wrapper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# Eclipse Gradle plugin generated files
.project
.classpath

# Android Studio build artifacts
/android/app/debug
/android/app/profile
/android/app/release


